# Server-only secrets. Never expose these with a VITE_ prefix.

# WakaTime coding activity
WAKATIME_API_KEY=replace_with_your_wakatime_secret_api_key
WAKATIME_TIMEZONE=Asia/Kolkata

# Habit Tracker Supabase project.
# Use the Habit Tracker database project here, not the separate Portfolio Supabase project.
HABIT_TRACKER_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
HABIT_TRACKER_SUPABASE_SECRET_KEY=replace_with_your_sb_secret_key

# Optional legacy fallback if that Supabase project has not migrated to sb_secret_* yet.
HABIT_TRACKER_SUPABASE_SERVICE_ROLE_KEY=

# The portfolio reads the `Workout` habit for this Habit Tracker user.
HABIT_TRACKER_USER_ID=7
HABIT_TRACKER_WORKOUT_TITLE=Workout
HABIT_TRACKER_TIMEZONE=Asia/Kolkata

# Reserved for the separate Portfolio Supabase project.
# We will use this later for last-known-good provider state / Now Building fallback.
PORTFOLIO_SUPABASE_URL=
PORTFOLIO_SUPABASE_SECRET_KEY=
